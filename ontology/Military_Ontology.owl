<?xml version="1.0"?>
<rdf:RDF xmlns="http://military.org/ontology#"
     xml:base="http://military.org/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://military.org/ontology"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://military.org/ontology#hasRegex -->

    <owl:AnnotationProperty rdf:about="http://military.org/ontology#hasRegex"/>
    


    <!-- http://military.org/ontology#super_col -->

    <owl:AnnotationProperty rdf:about="http://military.org/ontology#super_col"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://military.org/ontology#HasArmament -->

    <owl:ObjectProperty rdf:about="http://military.org/ontology#HasArmament">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#HasRelationship"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Armament"/>
        <rdfs:range rdf:resource="http://military.org/ontology#System"/>
        <hasRegex>REGEX:(armament|^munition|nuclear capable|payload|warhead|capacity)</hasRegex>
        <super_col>armament</super_col>
    </owl:ObjectProperty>
    


    <!-- http://military.org/ontology#HasCapability -->

    <owl:ObjectProperty rdf:about="http://military.org/ontology#HasCapability">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#HasMission"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://military.org/ontology#Capability"/>
        <hasRegex>REGEX:(mission|tasks)</hasRegex>
        <super_col>capability</super_col>
    </owl:ObjectProperty>
    


    <!-- http://military.org/ontology#HasCarrier -->

    <owl:ObjectProperty rdf:about="http://military.org/ontology#HasCarrier">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#HasRelationship"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Armament"/>
        <rdfs:range rdf:resource="http://military.org/ontology#Equipment"/>
        <hasRegex>REGEX:(platform|launch|mounted on|used (by|with))</hasRegex>
        <super_col>carrier</super_col>
    </owl:ObjectProperty>
    


    <!-- http://military.org/ontology#HasMission -->

    <owl:ObjectProperty rdf:about="http://military.org/ontology#HasMission">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://military.org/ontology#EquipMission"/>
    </owl:ObjectProperty>
    


    <!-- http://military.org/ontology#HasOrigin -->

    <owl:ObjectProperty rdf:about="http://military.org/ontology#HasOrigin">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://military.org/ontology#Country"/>
        <hasRegex>REGEX:(origin|builder|contractor|manufacturer|west germany|produced)</hasRegex>
        <super_col>origin</super_col>
    </owl:ObjectProperty>
    


    <!-- http://military.org/ontology#HasPropulsion -->

    <owl:ObjectProperty rdf:about="http://military.org/ontology#HasPropulsion">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#HasMission"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://military.org/ontology#Propulsion"/>
        <hasRegex>REGEX:(propulsion)</hasRegex>
        <super_col>propulsion</super_col>
    </owl:ObjectProperty>
    


    <!-- http://military.org/ontology#HasRelationship -->

    <owl:ObjectProperty rdf:about="http://military.org/ontology#HasRelationship">
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://military.org/ontology#Equipment"/>
    </owl:ObjectProperty>
    


    <!-- http://military.org/ontology#HasRole -->

    <owl:ObjectProperty rdf:about="http://military.org/ontology#HasRole">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#HasMission"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://military.org/ontology#Role"/>
        <hasRegex>REGEX:(role)</hasRegex>
        <super_col>role</super_col>
    </owl:ObjectProperty>
    


    <!-- http://military.org/ontology#HasStatus -->

    <owl:ObjectProperty rdf:about="http://military.org/ontology#HasStatus">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#HasOrigin"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://military.org/ontology#Status"/>
        <super_col>status</super_col>
    </owl:ObjectProperty>
    


    <!-- http://military.org/ontology#InventoryEquipment -->

    <owl:ObjectProperty rdf:about="http://military.org/ontology#InventoryEquipment">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#Inventory_Relationship"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Inventory"/>
        <rdfs:range rdf:resource="http://military.org/ontology#Equipment"/>
    </owl:ObjectProperty>
    


    <!-- http://military.org/ontology#Inventory_Relationship -->

    <owl:ObjectProperty rdf:about="http://military.org/ontology#Inventory_Relationship"/>
    


    <!-- http://military.org/ontology#OwnerCountry -->

    <owl:ObjectProperty rdf:about="http://military.org/ontology#OwnerCountry">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#Inventory_Relationship"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Inventory"/>
        <rdfs:range rdf:resource="http://military.org/ontology#Country"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://military.org/ontology#CoreID -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#CoreID"/>
    


    <!-- http://military.org/ontology#Dimensions -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#Dimensions">
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <hasRegex>(spec(ifications|s)|size)</hasRegex>
        <super_col>dimensions</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#HasCaliber -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#HasCaliber">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#HasWidth"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Ammunition"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Gun"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#MachineGun"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Pistol"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Rifle"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Shotgun"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>REGEX:(calib(er|re)|car(liber|tridge)|45mm|ammunition|^charge$|detonation|diameter|explosives)</hasRegex>
        <super_col>caliber</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#HasCost -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#HasCost">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#OriginData"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>REGEX:(cost)</hasRegex>
        <super_col>cost</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#HasDate -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#HasDate">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#OriginData"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>REGEX:(date|adopted|comm(\.|$|ission)|deployment|since|introduc(ed|tion)|laid down|launched|year|deliver(ed|y)|entered service)</hasRegex>
        <super_col>dates</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#HasDisplacement -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#HasDisplacement">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#HasWeight"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Vessel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>REGEX:(d(is|e)placement|disp(\.|$)|dp|tonn(age|erre))</hasRegex>
        <super_col>displacement</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#HasLength -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#HasLength">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#Dimensions"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>(length)</hasRegex>
        <super_col>length</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#HasNote -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#HasNote">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>REGEX:(note|attire|color|pattern|camouflage|colour|comment|description|detail|environment|example|extended content|guidance|info|mmsi|other features|protection|protection level|ref|ref\.|reference|refs|waffenfarbe)</hasRegex>
        <super_col>note</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#HasOtherNames -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#HasOtherNames">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#CoreID"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>REGEX:(designat(ion|or)|badge|des\.|emblem|nato (code|designation)|pennant|meaning|english|namesake|serial|(hull|imo|side) number|prefix)</hasRegex>
        <super_col>other_names</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#HasQuantity -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#HasQuantity">
        <rdfs:domain rdf:resource="http://military.org/ontology#Inventory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <hasRegex>REGEX:(qty|quantity|#|in service|accepted|active|in reserve|inventory|no\. (operated|used)|number(s| of| used)|total|operational|acquired)</hasRegex>
        <super_col>quantity</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#HasRange -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#HasRange">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#Dimensions"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>REGEX:(range|altitude)</hasRegex>
        <super_col>range</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#HasSpeed -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#HasSpeed">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#Dimensions"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Aircraft"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Vehicle"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Vessel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>(speed)</hasRegex>
        <super_col>speed</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#HasWeight -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#HasWeight">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#Dimensions"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Aircraft"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#SmallArm"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#System"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Vehicle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>(weight)</hasRegex>
        <super_col>weight</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#HasWidth -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#HasWidth">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#Dimensions"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>(width)</hasRegex>
        <super_col>width</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#IsType -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#IsType">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#CoreID"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>REGEX:(system|aircraft|artillery|vehicle|boat|ship|howitzer|intelligence|research|vessel|tanks|watercraft|radar|arms|firearm|gun|missile|mistral|mortars|weapon)</hasRegex>
        <super_col>equip_type</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#IsVariant -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#IsVariant">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#IsType"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>REGEX:(variant|hk33|version)</hasRegex>
        <super_col>variant</super_col>
    </owl:DatatypeProperty>
    


    <!-- http://military.org/ontology#OriginData -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#OriginData"/>
    


    <!-- http://military.org/ontology#ship_name -->

    <owl:DatatypeProperty rdf:about="http://military.org/ontology#ship_name">
        <rdfs:subPropertyOf rdf:resource="http://military.org/ontology#IsVariant"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#AircraftCarrier"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#AuxiliaryVessel"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Submarine"/>
        <rdfs:domain rdf:resource="http://military.org/ontology#Warship"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <hasRegex>REGEX:(ship name|chinese|hangul|hanja|han 中文|greek)</hasRegex>
        <super_col>ship_name</super_col>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://military.org/ontology#Accessory -->

    <owl:Class rdf:about="http://military.org/ontology#Accessory">
        <rdfs:subClassOf rdf:resource="http://military.org/ontology#SmallArm"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://military.org/ontology#HasCarrier"/>
                <owl:someValuesFrom rdf:resource="http://military.org/ontology#SmallArm"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasRegex>REGEX:(accessor|attachment|magazine|personnalisation|sights|lights)</hasRegex>
    </owl:Class>
    


    <!-- http://military.org/ontology#Active -->

    <owl:Class rdf:about="http://military.org/ontology#Active">
        <rdfs:subClassOf rdf:resource="http://military.org/ontology#Status"/>
        <hasRegex>REGEX:(active|current|Post-1990)</hasRegex>
    </owl:Class>
    


    <!-- http://military.org/ontology#Air_force -->

    <owl:Class rdf:about="http://military.org/ontology#Air_force">
        <rdfs:subClassOf rdf:resource="http://military.org/ontology#Branch"/>
        <hasRegex>REGEX:((air|aerospace) (force|corps))</hasRegex>
    </owl:Class>
    


    <!-- http://military.org/ontology#Air_to_air -->

    <owl:Class rdf:about="http://military.org/ontology#Air_to_air">
        <rdfs:subClassOf rdf:resource="http://military.org/ontology#DomainTransition"/>
    </owl:Class>
    


    <!-- http://military.org/ontology#Air_to_surface -->

    <owl:Class rdf:about="http://military.org/ontology#Air_to_surface">
        <rdfs:subClassOf rdf:resource="http://military.org/ontology#DomainTransition"/>
    </owl:Class>
    


    <!-- http://military.org/ontology#Aircraft -->

    <owl:Class rdf:about="http://military.org/ontology#Aircraft">
        <rdfs:subClassOf rdf:resource="http://military.org/ontology#Equipment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://military.org/ontology#HasPropulsion"/>
                <owl:someValuesFrom rdf:resource="http://military.org/ontology#Flight"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasRegex>REGEX:(air(craft|plane)|aviation|aeropla|pilot|wing|aeronautics)</hasRegex>
    </owl:Class>
    


    <!-- http://military.org/ontology#AircraftCarrier -->

    <owl:Class rdf:about="http://military.org/ontology#AircraftCarrier">
        <rdfs:subClassOf rdf:resource="http://military.org/ontology#Vessel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://military.org/ontology#HasRole"/>
                <owl:someValuesFrom rdf:resource="http://military.org/ontology#Aircraft_carrier"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://military.org/ontology#HasRole"/>
                <owl:someValuesFrom rdf:resource="http://military.org/ontology#Helecopter_carrier"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasRegex>REGEX:(aircraft carrier)</hasRegex>
    </owl:Class>
    


    <!-- http://military.org/ontology#Aircraft_carrier -->

    <owl:Class rdf:about="http://military.org/ontology#Aircraft_carrier">
        <rdfs:subClassOf rdf:resource="http://military.org/ontology#Carrier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://military.org/ontology#HasArmament"/>
                <owl:someValuesFrom rdf:resource="http://military.org/ontology#FixedWing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://military.org/ontology#HasArmament"/>
                <owl:someValuesFrom rdf:resource="http://military.org/ontology#RotorWing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://military.org/ontology#HasArmament"/>
                <owl:someValuesFrom rdf:resource="http://military.org/ontology#TiltWing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://military.org/ontology#Ammunition -->

    <owl:Class rdf:about="http://military.org/ontology#Ammunition">
        <rdfs:subClassOf rdf:resource="http://military.org/ontology#System"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://military.org/ontology#HasCarrier"/>
                <owl:someValuesFrom rdf:resource="http://military.org/ontology#Gun"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasRegex>REGEX:(ammunition)</hasRegex>
    </owl:Class>
    


    <!-- http://military.org/ontology#Amphibious -->

    <owl:Class rdf:about="http://military.org/ontology#Amphibious">
        <rdfs:subClassOf rdf:resource="http://military.org/ontology#DomainTransition"/>
    </owl:Class>
    


    <!-- http://military.org/ontology#AmphibiousVessel -->

    <owl:Class rdf:about="http://military.org/ontology#AmphibiousVessel">
        <rdfs:subClassOf rdf:resource="http://military.org/ontology#AircraftCarrier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://military.org/ontology#HasCapability"/>
                <owl:someValuesFrom rdf:resource="http://military.org/ontology#Amphibious"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasRegex>REGEX:(amphib|ferries)</hasRegex>
    </owl:Class>
    


    <!-- http://military.org/ontology#Animal -->

    <owl:Class rdf:about="http://military.org/ontology#Animal">
        <rdfs:subClassOf rdf:resource="http://military.org/ontology#Being"/>
        <hasRegex>REGEX:(animal)</hasRegex>
    </owl:Class>
    


    <!-- http://military.org/ontology#Anti_aircraft -->

    <owl:Class rdf:about="http://military.org/ontology#Anti_aircraft">
        <rdfs:subClassOf rdf:resource="http://military.org/ontology#Target"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://military.org/ontology#HasCapability"/>
                <owl:someValuesFrom rdf:resource="http://military.org/ontology#Air_to_air"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://military.org/ontology#HasCapability"/>
                <owl:someValuesFrom rdf:resource="http://military.org/ontology#Surface_to_air"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <hasRegex>REGEX:(manpad|shorad)</hasRegex>
    </owl:Class>
    


    <!-- http://military.org/ontology#Anti_armor -->

    <owl:Class rdf:about="http://military.org/ontology#Anti_armor">
